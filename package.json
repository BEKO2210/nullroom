{
  "name": "nullroom",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Clean-room reconstruction framework: isolated rooms, an audited spec wall, and a behavioral oracle.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BEKO2210/nullroom.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "os": [
    "linux"
  ],
  "bin": {
    "nullroom": "src/cli.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "pipeline": "node --experimental-strip-types src/cli.ts pipeline",
    "verify": "node --experimental-strip-types src/cli.ts verify",
    "doctor": "node --experimental-strip-types src/cli.ts doctor",
    "typecheck": "tsc -p .",
    "demo": "node --experimental-strip-types scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
